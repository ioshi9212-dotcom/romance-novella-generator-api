                }
              }
            }
          }
        }
      }
    },
    "/sessions/{session_id}/turns": {
      "get": {
        "operationId": "readArchivedTurns",
        "summary": "Read exact archived scenes for an inclusive range of up to 15 turns.",
        "description": "Read exact archived scenes for an inclusive range of up to 15 turns.",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "UUID returned by createNovel."
            }
          },
          {
            "name": "from_turn",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "description": "First archived turn."
          },
          {
            "name": "to_turn",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "description": "Last archived turn, inclusive."
          }
        ],
        "responses": {
          "200": {
            "description": "Response from the novel backend.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
