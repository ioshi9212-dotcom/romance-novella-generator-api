                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/sessions/{session_id}/resume": {
      "get": {
        "operationId": "resumeSession",
        "summary": "Resume this existing novel in a new ChatGPT chat.",
        "description": "Resume this existing novel in a new ChatGPT chat.",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
