            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/sessions/{session_id}/commit-turn": {
      "post": {
        "operationId": "commitTurn",
        "summary": "Persist one full scene and only real JSON changes, atomically and idempotently.",
        "description": "Persist one full scene and only real JSON changes, atomically and idempotently.",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "UUID returned by createNovel."
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CommitTurn"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Response from the novel backend.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/sessions/{session_id}/prepare-audit": {
      "post": {
        "operationId": "prepareAudit",
        "summary": "Read archived last 15 turns and selected memories for review.",
        "description": "Read archived last 15 turns and selected memories for review.",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
