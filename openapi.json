                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/sessions/{session_id}/rollback-last-turn": {
      "post": {
        "operationId": "rollbackLastTurn",
        "summary": "Undo exactly the most recent turn and all its persisted data changes.",
        "description": "Undo exactly the most recent turn and all its persisted data changes.",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "UUID returned by createNovel."
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
