                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/sessions/{session_id}/commit-audit": {
      "post": {
        "operationId": "commitAudit",
        "summary": "Save evidence-linked audit fixes and mark the checkpoint reviewed.",
        "description": "Save evidence-linked audit fixes and mark the checkpoint reviewed.",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
