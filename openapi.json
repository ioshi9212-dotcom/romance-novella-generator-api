            "description": "Response from the novel backend.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/sessions/{session_id}/prepare-turn": {
      "post": {
        "operationId": "prepareTurn",
        "summary": "Read complete selected context for the next game turn without mutating data.",
        "description": "Read complete selected context for the next game turn without mutating data.",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
